---
import type { GetStaticPaths } from "astro";
import NavItem from "$components/navigation/NavItem.astro";
import NavSection from "$components/navigation/NavSection.astro";
import ContentPage from "$layouts/ContentPage.astro";
import { render } from "astro:content";
import { getCollection } from "astro:content";
import Reactions from "$components/elements/Reactions.astro";
import StickyNote from "$components/containers/StickyNote.astro";
import Content from "$components/elements/text/Content.astro";

export const getStaticPaths = (async ({ paginate }) => {
    let posts = await getCollection("post");

    return posts.map((post) => {
        return {
            params: {
                post: post.data.slug,
            },
            props: {
                post,
            },
        };
    });
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content: PostContent, headings } = await render(post);

if (post.data.url) {
    return Astro.redirect(post.data.url);
}
---

<ContentPage title={post.data.title}>
    <Fragment slot="head">
        <meta property="og:title" content={post.data.title} />
        <meta
            property="og:image"
            content={new URL(post.data.image ?? "/images/post-default.png", Astro.url)}
        />
        <meta property="og:url" content={Astro.url} />
        <meta property="og:type" content="article" />
        <meta property="article:published_time" content={post.data.published.toISOString()} />
        <meta property="article:author" content={new URL("/", Astro.url)} />

        <!-- furryring stylesheet -->
        <link rel="stylesheet" href="https://furryring.neocities.org/onionring.css" />
    </Fragment>

    <Fragment slot="navigation">
        <NavSection name="Explore">
            <NavItem name="Home" href="/" />
            <NavItem name="Posts" href="/posts" />
        </NavSection>
    </Fragment>

    <Fragment slot="contents">
        <NavSection name="On This Page">
            {headings.map((heading) => <NavItem name={heading.text} href={`#${heading.slug}`} />)}
        </NavSection>
    </Fragment>

    <Fragment slot="main">
        <PostContent post={post} />

        {
            post.data.reactions && (
                <div class="reactions-container">
                    <StickyNote color="yellow">
                        <Content>
                            <div class="reactions">
                                <Reactions
                                    settings={{ theme: "outline", theme_color: "rgb(0, 0, 0)" }}
                                    {...post.data.reactions}
                                />
                            </div>
                        </Content>
                    </StickyNote>
                </div>
            )
        }
    </Fragment>
</ContentPage>

<style lang="scss">
    .reactions-container {
        min-width: 10rem;
        max-width: 18.5rem;
        align-self: center;

        text-align: center;
    }

    .reactions {
        --content-gap: 0.25rem;

        display: flex;
        flex-direction: column;
        align-items: center;
    }
</style>
