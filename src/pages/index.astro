---
import ContentPage from "$layouts/ContentPage.astro";
import NavSection from "$components/navigation/NavSection.astro";
import NavItem from "$components/navigation/NavItem.astro";
import SiteBanner from "$components/site/SiteBanner.astro";
import Paper from "$components/containers/Paper.astro";
import PaperTitle from "$components/elements/text/PaperTitle.astro";
import Content from "$components/elements/text/Content.astro";
import ArrowButton from "$components/elements/buttons/ArrowButton.astro";
import Hyperlink from "$components/elements/text/Hyperlink.astro";
import Emoticon from "$components/elements/images/Emoticon.astro";
import { getCollection } from "astro:content";
import PostCard from "$components/elements/PostCard.astro";
import PolaroidGrid from "$components/layouts/polaroid-grid/PolaroidGrid.astro";
import PolaroidGridItem from "$components/layouts/polaroid-grid/PolaroidGridItem.astro";
import ActivitySection from "$components/site/activity/ActivitySection.astro";
import Reactions from "$components/elements/Reactions.astro";

let posts = (await getCollection("post"))
    .filter((post) => post.data.showcase && !post.data.unlisted)
    .toSorted((a, b) => b.data.published.getTime() - a.data.published.getTime())
    .slice(0, 3);

const buttonSnippet = `<a href="https://paperbark.horse" target="_blank" rel="noopener noreferrer"><img src="https://paperbark.horse/88x31-button.png" alt="Paperbark" /></a>`;
---

<ContentPage title="Home">
    <Fragment slot="head">
        <meta property="og:title" content="Paperbark" />
        <meta property="og:image" content={new URL("/images/ocs/paperbark/profile.jpg", Astro.url)} />
        <meta property="og:url" content={Astro.url} />
        <meta property="og:type" content="profile" />
        <meta property="profile:username" content="Paperbark" />

        <!-- furryring stylesheet -->
        <link rel="stylesheet" href="https://furryring.neocities.org/onionring.css" />
    </Fragment>

    <Fragment slot="navigation">
        <NavSection name="Explore">
            <NavItem name="Home" href="/" />
            <NavItem name="Socials" href="/socials" />
            <NavItem name="Posts" href="/posts" />
            <NavItem name="Guestbook" href="https://paperbark.atabook.org/" />
        </NavSection>
        <NavSection name="Creations">
            <NavItem name="OCs" href="/ocs" />
            <NavItem name="Playlists" href="/playlists" />
        </NavSection>
        <NavSection name="Favourites">
            <NavItem name="Music" href="/music" disabled={true} />
            <NavItem name="Games" href="/games" disabled={true} />
            <NavItem name="Media" href="/media" disabled={true} />
            <NavItem name="Links" href="/links" disabled={true} />
            <NavItem name="Blinkies" href="/blinkies" />
        </NavSection>
    </Fragment>

    <Fragment slot="contents">
        <NavSection name="On This Page">
            <NavItem name="Welcome" href="#welcome" />
            <NavItem name="About" href="#about" />
            <NavItem name="The Noticeboard" href="#the-noticeboard" />
            <NavItem name="Webrings" href="#webrings" />
            <NavItem name="Neighbours" href="#neighbours" />
        </NavSection>
    </Fragment>

    <Fragment slot="header">
        <SiteBanner />

        <!-- <div class="motd">
            <StickyNote color="green">
                <Content>
                </Content>
            </StickyNote>
        </div> -->
    </Fragment>

    <Fragment slot="main">
        <Paper>
            <PaperTitle el="h1" title="Welcome" />
            <Content>
                <p>
                    Hey there, welcome to my website! This place is still a major work in progress, but I try
                    and add new stuff quite often. Feel free to take a look around, and if you'd like you can
                    <Hyperlink href="https://paperbark.atabook.org/"
                        >leave a message in my guestbook</Hyperlink
                    >
                    or <Hyperlink href="/socials">find me on my other socials</Hyperlink>!
                </p>
                <div class="reactions">
                    <Reactions type="manual" iid="4354" />
                </div>
            </Content>
        </Paper>
        <ActivitySection />
        <Paper>
            <PaperTitle el="h2" title="About" />
            <Content>
                <ul>
                    <li>Pronouns are "He/Him" or "They/Them"</li>
                    <li>
                        Proudly aroace! <Emoticon src="/images/emoticons/aroace-flag.svg" />
                    </li>
                    <li>
                        My Little Pony fan with an obsession for Vinyl Scratch
                        <Emoticon src="/images/emoticons/vinyl-nod.gif" />
                    </li>
                    <li>I'm a furry and a fursuiter</li>
                    <li>Lover of plushies, pooltoys, and anything else soft and cuddly</li>
                    <li>Programmer and AV enthusiast</li>
                    <li>Hugs are 100% encouraged, but please ask first!</li>
                </ul>
            </Content>
        </Paper>
        <Paper>
            <PaperTitle el="h2" title="The Noticeboard" />
            <div class="articles">
                {
                    posts.map((post) => (
                        <div>
                            <PostCard {post} embedded={true} />
                        </div>
                    ))
                }
                <div class="actions">
                    <ArrowButton href="/posts">Read more posts</ArrowButton>
                </div>
            </div>
        </Paper>
        <Paper>
            <PaperTitle el="h2" title="Webrings" />
            <div class="webring-list">
                <!-- PonyRing -->
                <div>
                    <center>
                        <a href="https://silversneasel.neocities.org/ponyring/main">
                            <b>
                                PonyRing!<br />
                                <img
                                    src="https://silversneasel.neocities.org/pictures/ponyring/widget/g4-1.png"
                                    height="90"
                                />
                            </b>
                        </a>
                        <a href="https://silversneasel.neocities.org/ponyring/main?action=previous">&lt;-</a>
                        <a href="https://silversneasel.neocities.org/ponyring/main?action=random">random</a>
                        <a href="https://silversneasel.neocities.org/ponyring/main?action=next">-&gt;</a>
                    </center>
                </div>
                <!-- furryring -->
                <div id="furryring">
                    <script
                        type="text/javascript"
                        src="https://furryring.neocities.org/onionring-variables.js"></script>
                    <script type="text/javascript" src="https://furryring.neocities.org/onionring-widget.js"
                    ></script>
                </div>
            </div>
        </Paper>
        <Paper>
            <PaperTitle el="h2" title="Neighbours" />
            <PolaroidGrid>
                <PolaroidGridItem
                    src="/images/neighbours/soda-abyss.jpg"
                    href="https://linktr.ee/sodaspaceshop"
                    title="Soda Abyss"
                    angle="-2deg"
                />
            </PolaroidGrid>
            <!-- <div class="buttons-grid" style="margin-top: 1rem;">
                <Blinkie type="button" href="" src="" />
            </div> -->
            <div class="neighbour-cta">
                <div class="neighbour-cta-content">
                    <Content>
                        <h3>Add me to your site!</h3>
                        <div class="self-button">
                            <img src="/88x31-button.png" alt="" />
                            <textarea readonly>{buttonSnippet}</textarea>
                        </div>
                        <p>Hotlinking my 88x31 button is allowed!</p>
                        <p>
                            Be sure to <Hyperlink href="https://paperbark.atabook.org/"
                                >leave a message</Hyperlink
                            > if you link back to my site, I'd love to see your website too and feature it here!
                        </p>
                    </Content>
                </div>
            </div>
        </Paper>
    </Fragment>
</ContentPage>

<style lang="scss">
    .placeholder-content {
        display: flex;
        flex-direction: column;

        padding-block: 2rem;
        gap: 1rem;

        text-align: center;
        font-style: italic;
    }

    .motd {
        max-width: 32rem;

        padding: 0.5rem;
        margin-bottom: 2rem;
    }

    .webring-list {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));

        align-items: center;
        justify-items: center;

        gap: 1rem;
    }

    .neighbour-list {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));

        gap: 1rem;

        .neighbour {
            display: flex;
            flex-direction: column;

            align-items: center;

            gap: 0.5rem;

            font-weight: var(--font-semibold);
            text-align: center;
        }
    }

    .neighbour-cta {
        text-align: center;

        padding-top: 1.5rem;
        margin-top: 1.5rem;
        border-top: 0.2rem solid #00000011;

        .neighbour-cta-content {
            max-width: 30rem;
            margin: 0 auto;
        }

        .self-button {
            display: grid;
            grid-template-columns: auto 1fr;

            gap: 0.5rem;

            @container (width < 500px) {
                grid-template-columns: 1fr;
                justify-items: center;
            }

            img {
                width: 146px;
                image-rendering: pixelated;
            }

            textarea {
                width: 100%;

                resize: none;
                text-wrap: nowrap;
                scrollbar-width: thin;
            }
        }
    }

    .articles {
        display: flex;
        flex-direction: column;

        > :not(:last-child) {
            padding-bottom: 1.5rem;
            margin-bottom: 1.5rem;
            border-bottom: 0.2rem solid #00000011;
        }

        .actions {
            display: flex;
            flex-direction: row;
            margin-bottom: 0.5rem;
        }
    }

    .buttons-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(146px, 1fr));
        justify-items: center;
        gap: 0.25rem;
    }
</style>
