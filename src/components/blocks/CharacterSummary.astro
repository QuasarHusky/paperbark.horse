---
import Paper from "$components/containers/Paper.astro";
import Polaroid from "$components/elements/images/Polaroid.astro";
import Reactions from "$components/elements/Reactions.astro";
import PaperTitle from "$components/elements/text/PaperTitle.astro";
import type { ComponentProps } from "astro/types";

interface Props {
    name: string;
    image: string;
    reactions?: ComponentProps<typeof Reactions>;
}

let { name, image, reactions } = Astro.props;
---

<Paper>
    <div class="character-summary">
        <div class="title-container">
            <PaperTitle el="h1" title={name} spacing={false} />
        </div>
        <div class="polaroid-container">
            <Polaroid src={image} angle="3deg" width="100%" />
        </div>
        {
            reactions && (
                <div class="reactions-container">
                    <Reactions {...reactions} />
                </div>
            )
        }
        <div class="info-container">
            <slot name="info" />
        </div>
        <div class="description-container">
            <slot name="description" />
        </div>
    </div>
</Paper>

<style lang="scss">
    .character-summary {
        display: grid;
        justify-items: start;

        grid-template-columns: 3fr 2fr;
        grid-template-areas:
            "title polaroid"
            "info polaroid"
            "info reactions"
            "description description";

        row-gap: 1rem;
    }

    .title-container {
        grid-area: title;
    }

    .polaroid-container {
        width: 100%;
        max-width: 12.5rem;
        grid-area: polaroid;

        justify-self: center;

        padding: 0.5rem;
    }

    .info-container {
        grid-area: info;
    }

    .description-container {
        grid-area: description;
    }

    .reactions-container {
        grid-area: reactions;
        justify-self: center;
    }

    @container (width < 35rem) {
        .character-summary {
            grid-template-columns: 1fr;
            grid-template-areas:
                "title"
                "polaroid"
                "reactions"
                "info"
                "description";
        }

        .polaroid-container {
            max-width: 15rem;
        }
    }
</style>
