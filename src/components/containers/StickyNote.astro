---
interface Props {
    padding?: boolean;
    color?: "yellow" | "green" | "white" | "blue";
}

const { padding = true, color = "yellow" } = Astro.props;
---

<div class:list={["sticky-note", "theme-sticky-note", `sticky-note-color-${color}`, { padding }]}>
    <div class="sticky-note-background"></div>
    <div class="sticky-note-content">
        <slot />
    </div>
</div>

<style lang="scss">
    .sticky-note {
        position: relative;

        filter: var(--filter-shadow-medium);

        &.padding .sticky-note-content {
            padding: 1rem 1.5rem;
        }

        &.sticky-note-color-yellow .sticky-note-background {
            background-image: var(--sticky-note-yellow-gradient);
        }

        &.sticky-note-color-green .sticky-note-background {
            background-image: var(--sticky-note-green-gradient);
        }

        &.sticky-note-color-white .sticky-note-background {
            background-image: var(--sticky-note-white-gradient);
        }

        &.sticky-note-color-blue .sticky-note-background {
            background-image: var(--sticky-note-blue-gradient);
        }
    }

    .sticky-note-background {
        position: absolute;
        inset: 0;

        border-radius: var(--sticky-note-corner-radius);

        color: var(--text-black);

        clip-path: polygon(
            0 0,
            100% 0,
            100% calc(100% - var(--sticky-note-fold-size)),
            calc(100% - var(--sticky-note-fold-size)) 100%,
            0 100%
        );
        z-index: -1;

        &::after {
            content: "";
            position: absolute;
            bottom: 0;
            right: 0;
            width: var(--sticky-note-fold-size);
            height: var(--sticky-note-fold-size);

            border-top-left-radius: var(--sticky-note-corner-radius);

            background-color: #00000012;
        }
        &::after {
            content: "";
            position: absolute;
            bottom: 0;
            right: 0;
            width: var(--sticky-note-fold-size);
            height: var(--sticky-note-fold-size);

            border-top-left-radius: var(--sticky-note-corner-radius);

            background-color: rgba(0, 0, 0, 0.08);
        }
    }
</style>

<style lang="scss" is:global>
    :root {
        --sticky-note-fold-size: 1.2rem;
        --sticky-note-corner-radius: 0.2rem;
    }

    .main > .sticky-note {
        margin-inline: 1rem;
    }
</style>
