---
import GithubSlugger from "github-slugger";

interface Props {
    el: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
    title: string;
    id?: string;
    spacing?: boolean;
}

let { el, title, id = undefined, spacing = true } = Astro.props;

let Element = el;

if (id === undefined) {
    id = new GithubSlugger().slug(title);
}
---

<div class:list={["paper-title", { spacing }]} id={id}>
    <Element>{title}</Element>
</div>

<style lang="scss">
    .paper-title {
        --paper-title-size: 1.8rem;

        min-width: min(80vw, 20rem);
        align-self: flex-start;

        margin-left: calc(var(--paper-edge-width) * -1 - 1.2rem);
        padding-left: calc(var(--paper-edge-width) + 1.2rem);
        padding-right: calc(var(--paper-title-size) + 1rem);
        padding-block: 0.5rem;

        background-color: var(--cutie-mark-orange);

        font-size: 2rem;
        font-weight: var(--font-semibold);
        line-height: 1.1;
        color: var(--text-white);

        z-index: 1;
        clip-path: polygon(0 0, 100% 0, calc(100% - var(--paper-title-size)) 50%, 100% 100%, 0 100%);

        scroll-margin-top: 2rem;

        &.spacing {
            margin-bottom: 1rem;
        }
    }
</style>
